# Maps this app's env var names to their Azure Key Vault secret names for the dev_javier stage.
# Key Vault secret names can't contain underscores (letters/digits/hyphens only), hence the
# separate names below rather than reusing the env var names directly.
ADMIN_PASSWORD=shift-green-fresh-shared-admin-password
ADMIN_SESSION_SECRET=shift-green-fresh-shared-admin-session-secret
SMTP_PASS=shift-green-fresh-shared-smtp-pass
MONGODB_URI=shift-green-fresh-shared-mongodb-uri
