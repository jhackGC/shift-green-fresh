# ADMIN_PASSWORD, ADMIN_SESSION_SECRET, SMTP_PASS, and MONGODB_URI are sourced from Azure Key
# Vault for local dev (run `pnpm dev:kv`, not `pnpm dev`) — see
# scripts/run-with-keyvault-env.sh. Left blank here since they're never meant to be filled in
# directly; the rest are plain config.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="true"
ORDER_NOTIFY_TO=""
ORDER_NOTIFY_FROM=""
